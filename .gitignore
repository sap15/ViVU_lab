# ---------------------------------------------------------------------------
# Datos estructurales y científicos grandes
# ---------------------------------------------------------------------------

*.h5
*.hdf5
*.hdf
*.pdb
*.cif
*.mmcif
*.bcif
*.mmtf

# Permitir únicamente las muestras pequeñas y explícitas del repositorio
!sample_data/examples/
!sample_data/examples/*.h5
!sample_data/examples/*.hdf5
!sample_data/examples/**/*.h5
!sample_data/examples/**/*.hdf5

# Permitir esquemas y documentación de la muestra
!sample_data/README.md
!sample_data/sample_schema.json

